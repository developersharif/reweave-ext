{
  "name": "reweave-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @reskin/extension dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:manifest && pnpm check:size && pnpm --filter @reskin/schema check:json-schema",
    "test:e2e": "pnpm --filter @reskin/extension test:e2e",
    "reskin": "node --disable-warning=ExperimentalWarning packages/compiler/bin/reskin.js",
    "check:size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  }
}
