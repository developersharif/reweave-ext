{
  "name": "@reskin/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@reskin/brand": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "1.2.2",
    "wxt": "0.21.5"
  }
}
