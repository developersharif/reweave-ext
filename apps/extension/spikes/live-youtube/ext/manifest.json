{
  "manifest_version": 3,
  "name": "rk-spike",
  "version": "0.0.1",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["cs.js"], "run_at": "document_start" }
  ]
}
