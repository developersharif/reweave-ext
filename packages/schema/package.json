{
  "name": "@reskin/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./json/*": "./json/*",
    "./routes": "./src/routes.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "gen:json-schema": "node --disable-warning=ExperimentalWarning scripts/gen-json-schema.ts",
    "check:json-schema": "node --disable-warning=ExperimentalWarning scripts/gen-json-schema.ts --check"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@valibot/to-json-schema": "1.8.0",
    "@reskin/test-fixtures": "workspace:*",
    "@types/node": "^24"
  },
  "sideEffects": false
}
