{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site adapter v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^\\/[A-Za-z0-9/@*._~%-]*$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^\\/[A-Za-z0-9/@*._~%-]*$"
                },
                "minItems": 1,
                "maxItems": 16
              }
            ]
          },
          "sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "routes": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                },
                {
                  "const": "*"
                }
              ]
            },
            "minItems": 1
          },
          "protected": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "selector"
        ]
      }
    },
    "shadowRoots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "host",
          "components"
        ]
      }
    },
    "navigationEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "maxItems": 8
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "route": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "expect": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          }
        },
        "required": [
          "component",
          "route",
          "expect"
        ]
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "follow": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^--[A-Za-z0-9_-]{1,80}$"
          }
        },
        "bind": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^--[A-Za-z0-9_-]{1,80}$"
            },
            "minItems": 1,
            "maxItems": 64
          }
        }
      },
      "required": [
        "scope"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "hosts",
    "routes",
    "components"
  ]
}
