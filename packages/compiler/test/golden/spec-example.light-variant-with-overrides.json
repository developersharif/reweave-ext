{
  "engineVersion": "1.0.0",
  "templateId": "demo/minimal-youtube",
  "templateVersion": "1.2.0",
  "adapterId": "youtube",
  "adapterVersion": "2.3.1",
  "groups": [
    {
      "routes": [
        "channel",
        "home",
        "search",
        "shorts",
        "watch"
      ],
      "css": [
        ":root{--rk-color-bg:#1a1a2e;--rk-color-surface:#18181b;--rk-color-surface-2:#222226;--rk-color-text:oklch(0.93 0.02 280);--rk-color-text-muted:#a0a0ab;--rk-color-accent:#ff8800;--rk-color-accent-text:#0f0f10;--rk-color-border:#2e2e33;--rk-color-link:#8ab4f8;--rk-color-danger:#f7768e;--rk-color-success:#9ece6a;--rk-font-body:\"Atkinson Hyperlegible\", system-ui, sans-serif;--rk-font-heading:system-ui, sans-serif;--rk-font-mono:ui-monospace, monospace;--rk-font-scale:1;--rk-radius-sm:4px;--rk-radius-md:12px;--rk-radius-lg:16px;--rk-space-scale:1;--rk-motion-duration:200ms;--rk-s-max-width:1200px}",
        "@font-face{font-family:\"Inter\";src:url(data:font/woff2;base64,d09GMgABAAAAAA==)format(\"woff2\");font-display:swap}",
        ":is(ytd-masthead){background:var(--rk-color-bg);border-bottom:1px solid var(--rk-color-border)}",
        ":is(ytd-rich-item-renderer,ytd-video-renderer){border-radius:var(--rk-radius-md);transition:transform var(--rk-motion-duration)}",
        ":is(ytd-rich-item-renderer,ytd-video-renderer):hover{transform:translateY(-2px)}",
        "ytd-rich-shelf-renderer[is-shorts],ytd-reel-shelf-renderer{display:none!important}"
      ]
    },
    {
      "routes": [
        "home"
      ],
      "css": [
        ":is(ytd-rich-item-renderer,ytd-video-renderer){background:var(--rk-color-surface)}"
      ]
    },
    {
      "routes": [
        "watch"
      ],
      "css": [
        ":is(#primary.ytd-watch-flexy){max-width:var(--rk-s-max-width);margin-inline:auto}",
        ":is(ytd-watch-metadata h1){font:600 1.4rem/1.3 var(--rk-font-body);color:var(--rk-color-text)}",
        ":is(#secondary.ytd-watch-flexy){opacity:.6;transition:opacity .2s}",
        ":is(#secondary.ytd-watch-flexy):hover{opacity:1}"
      ]
    }
  ],
  "sensitiveRoutes": [
    "account"
  ],
  "routeTable": {
    "home": [
      "/"
    ],
    "watch": [
      "/watch"
    ],
    "shorts": [
      "/shorts/*"
    ],
    "search": [
      "/results"
    ],
    "channel": [
      "/@*",
      "/channel/*",
      "/c/*"
    ],
    "account": [
      "/account*"
    ]
  },
  "rawSelectors": false,
  "components": [
    "comment",
    "home-feed",
    "masthead",
    "primary-column",
    "related-sidebar",
    "shorts-shelf",
    "video-card",
    "video-title"
  ],
  "assets": [
    "inter"
  ],
  "navigationEvents": [
    "yt-navigate-finish"
  ],
  "protectedSelectors": [
    "ytd-consent-bump-v2-lightbox"
  ],
  "probes": [
    {
      "component": "masthead",
      "route": "home",
      "expect": "present",
      "selector": "ytd-masthead"
    },
    {
      "component": "primary-column",
      "route": "watch",
      "expect": "present",
      "selector": "#primary.ytd-watch-flexy"
    }
  ],
  "themeVars": [],
  "hash": "07b062a6f0c870"
}
