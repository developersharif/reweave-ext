{
  "$schema": "../../schema/json/template.v1.json",
  "schemaVersion": 1,
  "id": "reskin/focus-youtube",
  "name": "Focus YouTube",
  "summary": "Fewer distractions: no Shorts, optional no feed, recommendations or comments, and a narrower watch page.",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "handle": "reskin"
    }
  ],
  "category": "focus",
  "tags": ["focus", "no-shorts", "minimal"],
  "targets": [
    {
      "adapter": "youtube",
      "adapterRange": "^1.1.0",
      "styles": [
        {
          "file": "styles/base.css"
        },
        {
          "file": "styles/watch.css",
          "routes": ["watch"]
        }
      ],
      "hide": [
        {
          "component": "shorts-shelf",
          "when": "hideShorts"
        },
        {
          "component": "shorts-card",
          "when": "hideShorts"
        },
        {
          "component": "home-feed",
          "when": "hideHomeFeed",
          "routes": ["home"]
        },
        {
          "component": "related-sidebar",
          "when": "hideRelated",
          "routes": ["watch"]
        },
        {
          "component": "comments",
          "when": "hideComments",
          "routes": ["watch"]
        }
      ]
    }
  ],
  "tokens": {
    "consumes": "standard/v1"
  },
  "settings": [
    {
      "id": "hideShorts",
      "type": "boolean",
      "label": "Hide Shorts",
      "default": true
    },
    {
      "id": "hideHomeFeed",
      "type": "boolean",
      "label": "Hide home feed",
      "default": false
    },
    {
      "id": "hideRelated",
      "type": "boolean",
      "label": "Hide recommendations",
      "description": "The list of videos beside the one you're watching.",
      "default": false
    },
    {
      "id": "hideComments",
      "type": "boolean",
      "label": "Hide comments",
      "default": false
    },
    {
      "id": "maxWidth",
      "type": "range",
      "label": "Watch page width",
      "min": 960,
      "max": 1800,
      "step": 40,
      "unit": "px",
      "default": 1280
    }
  ],
  "variants": [
    {
      "id": "deep-focus",
      "label": "Deep focus",
      "settings": {
        "hideHomeFeed": true,
        "hideRelated": true,
        "hideComments": true
      }
    }
  ],
  "previews": [
    {
      "file": "previews/cover.jpg",
      "alt": "YouTube watch page with a centered column and no recommendations",
      "role": "cover"
    },
    {
      "file": "previews/before.jpg",
      "alt": "Before: a watch page with recommendations beside the video",
      "route": "watch"
    },
    {
      "file": "previews/after.jpg",
      "alt": "After: Deep focus, a centred column without recommendations or comments",
      "route": "watch"
    }
  ]
}
