  "sensitiveRoutes": [
    "account"
  ],
  "routeTable": {
    "home": [
      "/"
    ],
    "watch": [
      "/watch"
    ],
    "shorts": [
      "/shorts/*"
    ],
    "search": [
      "/results"
    ],
    "subscriptions": [
      "/feed/subscriptions"
    ],
    "playlist": [
      "/playlist"
    ],
    "channel": [
      "/@*",
      "/channel/*",
      "/c/*",
      "/user/*"
    ],
    "account": [
      "/account*",
      "/paid_memberships*",
      "/purchases*",
      "/premium*"
    ]
  },
  "rawSelectors": false,
  "components": [
    "chip-bar",
    "comments",
    "masthead",
    "shorts-card",
    "shorts-shelf",
    "video-card"
  ],
  "assets": [],
  "navigationEvents": [
    "yt-navigate-finish"
  ],
  "protectedSelectors": [
    "ytd-consent-bump-v2-lightbox"
  ],
  "probes": [
    {
      "component": "masthead",
      "route": "home",
      "expect": "present",
      "selector": "ytd-masthead"
    },
    {
      "component": "home-feed",
      "route": "home",
      "expect": "present",
      "selector": "ytd-browse[page-subtype='home'] ytd-rich-grid-renderer"
    },
    {
      "component": "watch-page",
      "route": "watch",
      "expect": "present",
      "selector": "ytd-watch-flexy"
    },
    {
      "component": "primary-column",
      "route": "watch",
      "expect": "present",
      "selector": "ytd-watch-flexy #primary"
    },
    {
      "component": "video-title",
      "route": "watch",
      "expect": "present",
      "selector": "ytd-watch-metadata h1"
    },
    {
      "component": "related-sidebar",
      "route": "watch",
      "expect": "present",
      "selector": "ytd-watch-flexy #secondary"
    },
    {
      "component": "search-results",
      "route": "search",
      "expect": "present",
      "selector": "ytd-search ytd-section-list-renderer"
    },
    {
      "component": "video-card",
      "route": "search",
      "expect": "present",
      "selector": "ytd-rich-item-renderer, ytd-video-renderer, yt-lockup-view-model:not(ytd-rich-item-renderer *)"
    },
    {
      "component": "shorts-player",
      "route": "shorts",
      "expect": "present",
      "selector": "ytd-shorts ytd-reel-video-renderer"
    },
    {
      "component": "channel-header",
      "route": "channel",
      "expect": "present",
      "selector": "ytd-browse[page-subtype='channels'] #page-header"
    },
    {
      "component": "playlist-header",
      "route": "playlist",
      "expect": "present",
      "selector": "ytd-browse[page-subtype='playlist'] #page-header"
    },
    {
      "component": "subscriptions-page",
      "route": "subscriptions",
      "expect": "present",
      "selector": "ytd-browse[page-subtype='subscriptions']"
    },
    {
      "component": "chip-bar",
      "route": "search",
      "expect": "present",
      "selector": "yt-chip-cloud-renderer, chip-bar-view-model"
    },
    {
      "component": "comments",
      "route": "watch",
      "expect": "present",
      "selector": "ytd-watch-flexy ytd-comments#comments"
    },
    {
      "component": "video-grid",
      "route": "home",
      "expect": "present",
      "selector": "ytd-rich-grid-renderer"
    }
  ],
